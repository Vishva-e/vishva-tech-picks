---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
interface Props { title: string; description: string; kind?: 'website'|'article'; }
const { title, description, kind = 'website' } = Astro.props;
const currentPath = Astro.url.pathname;
const live = import.meta.env.PUBLIC_SITE_LIVE === 'true';
const canonical = live && Astro.site ? new URL(currentPath, Astro.site).href : undefined;
const fullTitle = title === 'Home' ? 'Visha Tech Picks — Smart Tech. Clear Choices.' : `${title} | Visha Tech Picks`;
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F8FAFD" />
    <meta name="description" content={description} />
    <meta name="robots" content={live ? 'index,follow,max-image-preview:large' : 'noindex,nofollow,noarchive'} />
    <meta property="og:type" content={kind} />
    <meta property="og:site_name" content="Visha Tech Picks" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header path={currentPath} />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
