---
import type { CollectionEntry } from 'astro:content';
import { categoryBySlug, formatDate } from '../data/site';
interface Props { guide: CollectionEntry<'guides'>; prominent?: boolean }
const { guide, prominent = false } = Astro.props;
const category = categoryBySlug(guide.data.category);
---
<article class:list={['guide-card', { 'guide-card-prominent': prominent }]}>
  <a class="guide-image" href={`/guides/${guide.id}/`} tabindex="-1" aria-hidden="true">
    <span class="guide-illustration" aria-hidden="true">{category?.icon ?? '📘'}</span>
    <span class="guide-image-watermark" aria-hidden="true">{guide.data.category.replaceAll('-',' ')}</span>
  </a>
  <div class="guide-info">
    <div class="guide-meta"><span class="eyebrow">{category?.name ?? 'Technology'}</span><span class="dot" aria-hidden="true">·</span><span>{guide.data.readMinutes} min read</span></div>
    <h3><a href={`/guides/${guide.id}/`}>{guide.data.title}</a></h3>
    <p>{guide.data.description}</p>
    <div class="guide-bottom"><span>{formatDate(guide.data.updatedAt)}</span><a href={`/guides/${guide.id}/`} aria-label={`Read guide: ${guide.data.title}`}>Read guide <span aria-hidden="true">↗</span></a></div>
  </div>
</article>
