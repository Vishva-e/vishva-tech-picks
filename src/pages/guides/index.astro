---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideCard from '../../components/GuideCard.astro';
import PageHeading from '../../components/PageHeading.astro';
import { getCollection } from 'astro:content';
import { categories } from '../../data/site';
const guides = (await getCollection('guides', ({data}) => !data.draft)).sort((a,b) => b.data.updatedAt.getTime()-a.data.updatedAt.getTime());
---
<BaseLayout title="Buying guides" description="Browse our independent laptop, developer gear and electronics buying guides. Practical, research-led advice for tech buyers in India.">
  <PageHeading eyebrow="The library" title="Explore buying guides" description="The important details, without the overwhelming specs. Browse by category or search our growing editorial library." />
  <section class="shell listing-section">
    <label class="search-box" for="guide-search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.8" cy="10.8" r="7"/><path d="m16 16 5 5"/></svg><input id="guide-search" type="search" placeholder="Search guides (e.g. laptop, RAM, keyboard)" autocomplete="off" aria-controls="guide-list" /></label>
    <div class="filter-row"><a href="/guides/" aria-current="page">All guides</a>{categories.map(category=><a href={`/categories/${category.slug}/`}>{category.name}</a>)}</div>
    <div class="guide-grid" id="guide-list">{guides.map(guide=><div class="search-item" data-search={`${guide.data.title} ${guide.data.description} ${guide.data.tags.join(' ')}`.toLowerCase()}><GuideCard guide={guide} /></div>)}</div>
    <div class="empty-state" id="search-empty" hidden>No matching guides found. Try a broader term.</div>
  </section>
</BaseLayout>
<script>
  const input = document.querySelector<HTMLInputElement>('#guide-search');
  const cards = [...document.querySelectorAll<HTMLElement>('.search-item')];
  const empty = document.querySelector<HTMLElement>('#search-empty');
  function applySearch(value: string) {
    const query = value.trim().toLocaleLowerCase('en-IN');
    let count = 0;
    for (const card of cards) {
      const matches = (card.dataset.search || '').includes(query);
      card.hidden = !matches;
      if (matches) count++;
    }
    if (empty) empty.hidden = count > 0;
  }
  if (input) {
    const query = new URLSearchParams(window.location.search).get('q') || '';
    input.value = query;
    applySearch(query);
    input.addEventListener('input', () => applySearch(input.value));
  }
</script>
<style>
  .search-item[hidden]{display:none}.search-item :global(.guide-card){height:100%}
</style>
