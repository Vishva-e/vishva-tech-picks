---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideCard from '../../components/GuideCard.astro';
import { categoryBySlug,formatDate } from '../../data/site';
import { getCollection, render, type CollectionEntry } from 'astro:content';
export async function getStaticPaths() {
  const guides = await getCollection('guides',({data}) => !data.draft);
  return guides.map(guide => ({params:{slug:guide.id}, props:{guide}}));
}
interface Props { guide: CollectionEntry<'guides'> }
const { guide } = Astro.props;
const { Content } = await render(guide);
const category = categoryBySlug(guide.data.category);
const related = (await getCollection('guides',({data}) => !data.draft && data.category===guide.data.category && data.title!==guide.data.title)).slice(0,2);
---
<BaseLayout title={guide.data.title} description={guide.data.description} kind="article">
  <article>
    <header class="article-head content-container" style="padding-bottom:0"><a class="eyebrow" href={`/categories/${guide.data.category}/`}>{category?.name ?? 'Technology'}</a><h1>{guide.data.title}</h1><p class="article-lede">{guide.data.description}</p><div class="article-meta">By Visha Tech Picks Editorial · Updated {formatDate(guide.data.updatedAt)} · {guide.data.readMinutes} min read</div></header>
    <div class="content-container">
      <div class="notice"><strong>Research transparency:</strong> This guide is based on {guide.data.reviewType === 'hands-on' ? 'documented hands-on testing' : 'editorial desk research and practical engineering considerations'}, not a claim that we have personally tested every product. We do not currently display live Amazon prices or referral links.</div>
      <div class="prose"><Content /></div>
      {guide.data.references.length > 0 && <section class="reference-list" aria-label="Further reading"><strong>Further reading and references</strong><ul>{guide.data.references.map(ref=><li><a href={ref.url} rel="noopener noreferrer" target="_blank">{ref.label} ↗</a></li>)}</ul></section>}
      <p class="article-meta" style="margin-top:32px">Originally published {formatDate(guide.data.publishedAt)} · Last editorial update {formatDate(guide.data.updatedAt)}</p>
      <div class="notice">Affiliate disclosure: This website may earn from qualifying purchases when approved affiliate links are added. We currently provide editorial information only. <a href="/affiliate-disclosure/">Read our disclosure.</a></div>
    </div>
  </article>
  {related.length > 0 && <section class="section section-white"><div class="shell"><div class="section-heading"><div><span class="eyebrow">Keep exploring</span><h2>Related guides</h2></div></div><div class="guide-grid">{related.map(item=><GuideCard guide={item}/>)}</div></div></section>}
</BaseLayout>
