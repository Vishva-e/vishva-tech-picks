---
import BaseLayout from '../layouts/BaseLayout.astro';
import GuideCard from '../components/GuideCard.astro';
import { categories } from '../data/site';
import { getCollection } from 'astro:content';
const guides = (await getCollection('guides', ({data}) => !data.draft)).sort((a,b) => b.data.updatedAt.getTime()-a.data.updatedAt.getTime());
const featured = [...guides].sort((a,b) => Number(b.data.featured)-Number(a.data.featured)).slice(0,3);
---
<BaseLayout title="Home" description="Straightforward technology buying guides for Indian students, developers, and professionals. Compare meaningful features and choose confidently.">
  <section class="hero"><div class="shell hero-grid">
    <div class="hero-copy">
      <span class="eyebrow eyebrow-pill">✦ Independent Tech Buying Guides</span>
      <h1>Good tech.<br /><span>Better decisions.</span></h1>
      <p>Skip the jargon and discover practical buying advice for laptops, coding accessories, and everyday tech. Clear recommendations, real trade-offs, zero hype.</p>
      <div class="hero-buttons"><a href="/guides/" class="btn btn-primary">Explore buying guides <span aria-hidden="true">↗</span></a><a href="/product-finder/" class="btn btn-secondary">Find your criteria <span aria-hidden="true">→</span></a></div>
      <div class="trust-note"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m5 12 4 4L19 6" stroke-linecap="round" stroke-linejoin="round"/></svg> Editorial-first advice · Made for Indian buyers</div>
    </div>
    <div class="hero-graphic" aria-hidden="true"><div class="orb"></div><div class="float-chip chip-top"><span>✧</span> Practical, not promotional</div><div class="laptop-art"><div class="laptop-screen"><div class="screen-content"><div class="screen-top"><i></i><b></b></div><div class="screen-main"><div class="screen-card"><div class="icon">💻</div><div class="screen-bar"></div></div><div class="screen-side"><div class="screen-bar short"></div><div class="screen-bar"></div><div class="screen-bar" style="width:79%"></div><div class="screen-bar" style="width:52%;background:#e2eaf8"></div></div></div></div></div><div class="laptop-base"></div></div><div class="float-chip chip-bottom"><span>✓</span> Transparent research</div></div>
  </div></section>
  <section class="section section-white"><div class="shell"><div class="section-heading"><div><span class="eyebrow">Browse by interest</span><h2>Find your next upgrade</h2><p>Start with a category and focus on the features that matter to you.</p></div><a class="text-link" href="/guides/">All guides ↗</a></div><div class="category-grid">{categories.map(category => <a class="category-card" href={`/categories/${category.slug}/`}><span class="category-icon" aria-hidden="true">{category.icon}</span><div><h3>{category.name}</h3><p>{category.summary}</p></div><span class="category-arrow" aria-hidden="true">↗</span></a>)}</div></div></section>
  <section class="section"><div class="shell"><div class="section-heading"><div><span class="eyebrow">Fresh perspectives</span><h2>Guides worth your time</h2><p>Our first editorial guides, written to help you think through buying decisions.</p></div><a class="text-link" href="/guides/">View all articles ↗</a></div><div class="guide-grid">{featured.map(guide => <GuideCard guide={guide} />)}</div></div></section>
  <section class="section section-white"><div class="shell"><div class="section-heading"><div><span class="eyebrow">Compare wisely</span><h2>Understand the trade-offs</h2><p>Explore side-by-side, evidence-led hardware comparisons without fake price tags.</p></div><a class="text-link" href="/comparisons/">Open comparison tool ↗</a></div><div class="guide-grid"><a class="category-card" href="/comparisons/?topic=ram"><span class="category-icon">🧠</span><div><h3>16 GB vs 32 GB RAM</h3><p>Match memory to your development workload.</p></div></a><a class="category-card" href="/comparisons/?topic=storage"><span class="category-icon">💾</span><div><h3>Internal vs external SSD</h3><p>Storage and backups explained.</p></div></a><a class="category-card" href="/comparisons/?topic=audio"><span class="category-icon">🎧</span><div><h3>Wired vs wireless audio</h3><p>Better meetings and calls.</p></div></a></div></div></section>
  <section class="section-commitment"><div class="shell"><div class="commitment"><div><span class="eyebrow">Our editorial promise</span><h2>Advice that puts you first.</h2><p>No invented hands-on tests. No disguised affiliate relationships. We explain what we know, how we researched it and what might not suit you.</p><a href="/editorial-policy/">Read our editorial standards ↗</a></div><div class="promise-points"><span><b>01</b> Clear pros and trade-offs</span><span><b>02</b> Research methods disclosed</span><span><b>03</b> Recommendations reviewed over time</span></div></div></div></section>
</BaseLayout>
